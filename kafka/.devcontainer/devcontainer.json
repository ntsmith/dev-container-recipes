  "features": {
    "docker-in-docker": "latest"
  },
  "runArgs": ["--network=host"],
  // "postCreateCommand": "/bin/bash /workspace/.devcontainer/setup.sh",
  // "postStartCommand": "/bin/bash /workspace/.devcontainer/setup.sh",
  "customizations": {
    "vscode": {
