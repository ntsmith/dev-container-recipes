{
  "name": "Ubuntu + Jupyter + Geo + ML (venv)",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "forwardPorts": [8888],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        // Use the venv inside the container
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": true,

        "jupyter.jupyterServerType": "local"
      }
    }
  },

  // Use the ubuntu user we create in the Dockerfile
  "remoteUser": "ubuntu",

  // Optional but nice: put the workspace in /workspaces/<repo-name>
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}
